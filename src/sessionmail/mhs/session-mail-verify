def main():
    # ONE parser: the header is read by _sig's byte parse, the one v2
    # verifies with, for EVERY mail, so _sig.py is needed for v1 too (a missing
    # one is a broken install: rc 3, --trust ERROR verifier-incomplete).
    S = load_sig()
    tags, why = sig_tags(S, raw_b)
    if why is not None:
        ambiguous(why)
    if tags is None:
        leg1("unsigned", "unsigned")
        out(f"unsigned          : no {SIGH} header")
        if trust:
            # Under --trust an unverifiable mail is a REJECTION (plain mode
            # keeps rc 2 for this; rc 2 never occurs under --trust).
            trust_fail("1-signature", "unsigned")
        sys.exit(2)

    sig_version = tags.get("v", "1")
    if sig_version == "2":
        # v2 verifies BYTES: a byte the locale cannot decode must not turn it
        # red, so its text (leg 2's From) keeps such a byte as a surrogate.
        verify_v2(S, raw_b, tags, email.message_from_string(mail_text(raw_b, "surrogateescape")))
    elif sig_version != "1":
        unsupported(f"unsupported signature version v={sig_version} "
                    "(this verifier reads v=1 and v=2)")
    # v1 signs TEXT (canonical(msg)): a mail that does not decode is refused,
    # rc 1, never a traceback (which exited 1 with no TRUST: line).
    try:
        msg = email.message_from_string(mail_text(raw_b))
    except ValueError as e:
        leg1("bad", "undecodable")
        out(f"signature-crypto  : ❌ NOT CHECKED: the mail is not text ({e})")
        print(f"session-mail-verify: BAD: a v1 mail must decode as text: {e}", file=sys.stderr)
        if trust:
            trust_fail("1-signature", "undecodable")
        sys.exit(1)
    ns = tags.get("n", MAIL_NS_DEFAULT)
    try:
        armor = (BEGIN + "\n"
                 + "\n".join(textwrap.wrap(tags["b"], 70))
                 + "\n" + END + "\n")
        blob, sig_ns = parse_sshsig(armor)
    except Exception as e:
        leg1("unverified", "signature-unparseable")
        print(f"signature parse failed: {e}", file=sys.stderr)
        if trust:
            # Fail closed under --trust: a signature header that cannot be
            # parsed is attacker-influenceable input (same principle as
            # cert-invalid) — it must not exit through the no-verdict rc-3
            # path. Plain mode keeps its rc 3 here, unchanged.
            trust_fail("1-signature", "bad-signature")
        sys.exit(3)
    sid = sid_from_blob(blob)
    keyline = f"{keytype(blob)} {base64.b64encode(blob).decode()}"
    # canonical()'s one exit is the v1 limit (rc 3, no TRUST: line), so it is
    # recorded here, before the call, and not inside canonical().
    leg1("unverified", "canonicalization-limit")
    data = canonical(msg)
    leg1(None)

    with tempfile.NamedTemporaryFile("w", suffix=".sig", delete=False) as f:
        f.write(armor)
        sigfile = f.name
    with tempfile.NamedTemporaryFile("w", suffix=".allowed", delete=False) as f:
        f.write(f"{sid}@session {keyline}\n")
        allowed = f.name

    # 1. cryptographic validity against the embedded key (no trust store needed)
    p1 = subprocess.run(
        ["ssh-keygen", "-Y", "check-novalidate", "-n", ns, "-s", sigfile],
        input=data, capture_output=True,
    )
    # 2. principal binding: <derived-sid>@session must map to the embedded key
    p2 = subprocess.run(
        ["ssh-keygen", "-Y", "verify", "-f", allowed, "-I", f"{sid}@session",
         "-n", ns, "-s", sigfile],
        input=data, capture_output=True,
    )

    ok = p1.returncode == 0 and p2.returncode == 0
    out(f"signature-crypto  : {'✅ good' if p1.returncode == 0 else '❌ BAD'}")
    out(f"principal-binding : {'✅ good' if p2.returncode == 0 else '❌ BAD'}")
    out(f"signer-key        : {keyline}")
    out(f"sender-session-id : {sid}")
    out(V1_COVERS)
    if not ok:
        leg1("bad", "bad-signature" if p1.returncode != 0 else "bad-principal")
        sys.stderr.write(p1.stderr.decode() + p2.stderr.decode())
        if trust:
            trust_fail("1-signature",
                       "bad-signature" if p1.returncode != 0 else "bad-principal")
        sys.exit(1)
    # The crypto is good, so the five headers and the body string are
    # the sender's. Nothing else is signed, so the mail must also be in the v1
    # sender's exact shape, or a reader may show text the signature never saw.
    refused = v1_refusal(S, raw_b)
    if refused is not None:
        reason, why = refused
        leg1("bad", reason)
        out(f"v1-shape          : ❌ {reason.upper()}: {why}")
        print(f"session-mail-verify: BAD: not the shape a v1 signature was made in: {why}",
              file=sys.stderr)
        if trust:
            trust_fail("1-signature", reason)
        sys.exit(1)
    leg1("good")
    if json_mode:
        # v1 signs the five HDRS, never the header's h=: the
        # first five lines of data, then the body (the first text part).
        five = data.split(b"\n", len(HDRS))
        J["sig"] = {
            "version": "1", "h": list(HDRS),
            "covered": (read_back(b"".join(x + b"\n" for x in five[:-1]), HDRS)
                        if len(five) == len(HDRS) + 1 else None),
            "parts": [{"index": 1, "type": "text/plain", "digest": None}],
            "signer": {"session_id": sid, "key": keyline}}
    if trust:
        run_trust(sid, keyline, msg)
    sys.exit(0)


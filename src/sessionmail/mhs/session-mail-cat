#!/usr/bin/env bash
# session-mail-cat — one MHS item + body; magic today / yesterday / latest (`cat /BOOT/latest` is the letter)
# Unix verbs over MHS paths: small plain pieces that combine, not one big
# special-purpose tool. One reader, mhs-thread, behind all of
# ls / tree / cat; agent from CLAUDE_CODE_AGENT, root from $<AGENT>_ROOT,
# --box NAME for a shared box. See `mhs-thread --help` for the flags.
exec ${SESSIONMAIL_PYTHON:+"$SESSIONMAIL_PYTHON"} "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/mhs-thread" cat "$@"
